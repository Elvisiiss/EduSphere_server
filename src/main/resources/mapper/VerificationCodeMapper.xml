<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lx.edusphere_server.mapper.VerificationCodeMapper">
    <resultMap id="BaseResultMap" type="com.lx.edusphere_server.entity.VerificationCode">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="code" property="code" jdbcType="VARCHAR"/>
        <result column="expiry_date" property="expiryDate" jdbcType="TIMESTAMP"/>
        <result column="purpose" property="purpose" jdbcType="VARCHAR"/>
    </resultMap>

    <insert id="insert" parameterType="com.lx.edusphere_server.entity.VerificationCode" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO verification_codes(email, code, expiry_date, purpose)
        VALUES(#{email}, #{code}, #{expiryDate}, #{purpose})
    </insert>

    <update id="update" parameterType="com.lx.edusphere_server.entity.VerificationCode">
        UPDATE verification_codes SET
                                      email = #{email},
                                      code = #{code},
                                      expiry_date = #{expiryDate},
                                      purpose = #{purpose}
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM verification_codes WHERE id = #{id}
    </select>

    <select id="findByEmailAndPurpose" resultMap="BaseResultMap">
        SELECT * FROM verification_codes WHERE email = #{email} AND purpose = #{purpose}
    </select>
</mapper>